<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inventory="using:MabiTool.Desktop.Pages.Inventory"
             xmlns:controls="using:MabiTool.Desktop.Controls"
             xmlns:tables="using:MabiTool.Desktop.Controls.Tables"
             xmlns:infrastructure="using:MabiTool.Desktop.Infrastructure"
             x:Class="MabiTool.Desktop.Pages.Inventory.InventoryPage"
             x:DataType="inventory:InventoryPageModel"
             controls:Card.PageId="inventory">
  <UserControl.Styles>
    <Style Selector="Button.chip.active">
      <Setter Property="Background" Value="{StaticResource InventoryBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource InventoryBrush}" />
    </Style>
    <!-- 主货币的一行与其余资源的紧凑格。 -->
    <Style Selector="Border.currency">
      <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InsetEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border.cell">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <!-- 资源的紧凑格：图标、数值与名称，来源与明细在悬停提示。 -->
    <DataTemplate x:Key="ResourceTile" DataType="inventory:InventoryResourceRow">
      <Border Classes="cell" ToolTip.Tip="{Binding Tip}">
        <DockPanel>
          <controls:GameIcon DockPanel.Dock="Left" Icon="{Binding Icon}" Size="24" Margin="0,0,8,0" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="name" FontWeight="SemiBold" Text="{Binding Value}" />
            <TextBlock Classes="note name" TextWrapping="NoWrap" Text="{Binding Name}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
    <!-- 未读取的一行：名称与原因。 -->
    <DataTemplate x:Key="UnreadResourceRow" DataType="inventory:InventoryResourceRow">
      <controls:PairRow Margin="0,2" Background="Transparent" ToolTip.Tip="{Binding Tip}">
        <TextBlock Classes="muted" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
        <TextBlock Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
      </controls:PairRow>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="8,4,8,14">
      <!-- 标题行：标题之后紧跟卡片布局的编辑入口（各页同一位置）；右端留给窗口右上角的按钮。 -->
      <DockPanel Margin="{DynamicResource TitleReserve}">
        <TextBlock DockPanel.Dock="Left" Classes="h1" Margin="0" Text="{DynamicResource I.Title}" />
        <controls:CardGridEditBar Target="{Binding #CardsGrid}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" />
      </DockPanel>
      <controls:ReflowPanel MinItemWidth="260" Spacing="12" Margin="0,4,0,0">
        <!-- 同步状态：背包随全局常驻抓包自动同步，没有开始/停止按钮。 -->
        <TextBlock x:Name="SyncStatus" Classes="body muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Data.Status}" />
        <TextBox x:Name="SearchBox" Classes="field" Text="{Binding Search}"
                 PlaceholderText="{DynamicResource I.SearchHint}" AutomationProperties.Name="{DynamicResource I.SearchHint}" />
      </controls:ReflowPanel>
      <TextBlock Margin="0,4,0,0" x:Name="CapabilityNotice" Classes="note" Text="{Binding CapabilityNotice}" IsVisible="{Binding HasCapabilityNotice}" />
      <!-- 估价：交易所价格，单位德卡，取价于何时；读不到时写原因，入口不可用时写明原因。 -->
      <TextBlock Margin="0,4,0,0" x:Name="ValuationLine" Classes="note" Text="{Binding ValuationLine}" IsVisible="{Binding HasValuationLine}" />
      <!-- 账号与显示的列组；在窗口中打开与导出 CSV 在表格左上角。 -->
      <WrapPanel Margin="0,8,0,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,16,6" VerticalAlignment="Center">
          <TextBlock Classes="label" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource I.Account}" />
          <ComboBox x:Name="AccountBox" MinWidth="160" MaxWidth="260" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                    IsEnabled="{Binding HasAccounts}" PlaceholderText="{DynamicResource I.NoAccount}"
                    AutomationProperties.Name="{DynamicResource I.Account}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="inventory:InventoryAccountOption">
                <TextBlock Classes="name" Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,16,6" VerticalAlignment="Center">
          <TextBlock Classes="label" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource I.Groups}" />
          <ItemsControl x:Name="GroupToggles" controls:StableItems.Source="{Binding Groups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="inventory:GroupToggle">
                <Button Classes="chip" Classes.active="{Binding Shown}" Content="{Binding Label}"
                        Command="{Binding Command}" CommandParameter="{Binding Id}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </WrapPanel>
    </StackPanel>

    <ScrollViewer x:Name="PageScroller" controls:EdgeFade.IsEnabled="True" Margin="-14,0,-14,0"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <!--
        卡片网格：物品 2×4（表格在表内滚动，卡片外壳不滚动），右侧资源 1×4 与物品等高；
        其下读取范围与道具名称目录各一列、随内容。顺序与尺寸档在“编辑布局”里调整。一张卡片同一方向只有一个滚动区。
      -->
      <controls:CardGrid x:Name="CardsGrid" Margin="14,0,14,18">
        <controls:Card x:Name="ItemsPanel" CardId="items" Title="{DynamicResource I.Items}" TitleTip="{DynamicResource I.TableHint}" Size="TwoByFour"
                       AllowedSizes="TwoByThree,TwoByAuto,FullWidth" ScrollsBody="False">
          <!-- 说明行停靠在底部，表格占满其余高度、在表内滚动；随内容档时表体最高 470。 -->
          <DockPanel>
            <tables:DataTable x:Name="ItemsTable" TableId="inventory.items" ColumnsSource="{Binding Columns}" ItemsSource="{Binding Rows}"
                              EmptyText="{DynamicResource I.NoItems}" CanExport="True" ExportFileName="{Binding ExportFileName}"
                              BodyMaxHeight="470">
              <!-- 表格左上角、表头“名称”上方：在窗口中打开与导出 CSV。 -->
              <tables:DataTable.CornerContent>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                  <Button x:Name="OpenWindowButton" Classes="chip" Content="{DynamicResource I.OpenWindow}" Click="OnOpenWindowClick" />
                  <Button x:Name="ExportButton" Classes="chip" Content="{DynamicResource I.ExportCsv}" Click="OnExportClick" />
                </StackPanel>
              </tables:DataTable.CornerContent>
            </tables:DataTable>
          </DockPanel>
        </controls:Card>

          <!-- 资源：货币的唯一位置。顶部选角色（所选账户下的角色，默认当前登录角色），主货币为金币、银币、魔族貢品竖排三行（银币与贡品带补充倒计时，
               全页一个每秒节拍，只改倒计时文字）；账户资源跟随账号下拉，角色资源按所选角色；都是图标加数值的紧凑格，名称、来源与明细在悬停提示。
               各组随内容展开，固定高度档由卡片外壳统一滚动（组内不再各自限高滚动）；未读取折叠。 -->
          <controls:Card x:Name="ResourcesPanel" CardId="resources" Title="{DynamicResource I.Resources}" TitleTip="{DynamicResource I.ResourcesHint}" Size="OneByFour"
                         AllowedSizes="OneByThree,OneByAuto,HalfByAuto">
            <controls:Card.Icon><controls:GameIcon Icon="currency/gold" Size="18" /></controls:Card.Icon>
            <StackPanel Spacing="6">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" Text="{DynamicResource I.SummaryCharacter}" />
                <TextBlock x:Name="ResourceCharacterLabel" Classes="name" VerticalAlignment="Center" TextAlignment="Right"
                           Text="{Binding ResourceCharacterLabel}" ToolTip.Tip="{Binding ResourceCharacterLabel}" />
              </DockPanel>
              <!-- 角色与透视表的角色列同一来源；默认当前登录角色。主货币与角色资源跟随这里的选择。 -->
              <ItemsControl x:Name="ResourceCharacterChips" controls:StableItems.Source="{Binding ResourceCharacters}" IsVisible="{Binding HasResourceCharacters}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="inventory:ResourceCharacterChoice">
                    <Button Classes="chip" Classes.active="{Binding Active}" Margin="0,0,6,4" Content="{Binding Name}"
                            Command="{Binding Command}" CommandParameter="{Binding Id}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="label" Margin="0,4,0,0" Text="{DynamicResource I.MainCurrencies}" />
              <!-- 主货币竖排一列：每行图标、名称与数值（数值右对齐、不截断，名称让出宽度），倒计时在名称下方。 -->
              <ItemsControl x:Name="MainCurrencyList" controls:StableItems.Source="{Binding MainCurrencies}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="inventory:InventoryResourceRow">
                    <Border Classes="currency" Margin="0,0,0,6" ToolTip.Tip="{Binding Tip}">
                      <DockPanel>
                        <controls:GameIcon DockPanel.Dock="Left" Icon="{Binding Icon}" Size="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Classes="name" FontSize="16" FontWeight="Bold" FontFeatures="+tnum" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Text="{Binding Value}" Classes.muted="{Binding !Observed}" />
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Classes="name" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <!-- 补充倒计时：小号、弱化色、等宽数字；金币没有时不占高度。 -->
                          <inventory:InventoryCountdownText Classes="name muted" FontSize="11" FontFeatures="+tnum" Refill="{Binding Refill}"
                                                            IsVisible="{Binding Refill, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="label" Margin="0,4,0,0" Text="{DynamicResource I.AccountResources}" />
              <ItemsControl x:Name="AccountResourceList" controls:StableItems.Source="{Binding AccountResources}" ItemTemplate="{StaticResource ResourceTile}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><controls:ReflowPanel MinItemWidth="130" Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <Button x:Name="UnreadAccountResourcesToggle" Classes="bare" HorizontalAlignment="Left" IsVisible="{Binding HasUnreadAccountResources}"
                      Command="{Binding ToggleUnreadAccountCommand}" Content="{Binding UnreadAccountResourcesText}" />
              <controls:ExpandPanel IsExpanded="{Binding UnreadAccountExpanded, Mode=OneWay}">
                <ItemsControl controls:StableItems.Source="{Binding UnreadAccountResources}" ItemTemplate="{StaticResource UnreadResourceRow}" />
              </controls:ExpandPanel>
              <TextBlock Classes="label" Margin="0,4,0,0" Text="{DynamicResource I.CharacterResources}" />
              <ItemsControl x:Name="CharacterResourceList" controls:StableItems.Source="{Binding CharacterResources}" ItemTemplate="{StaticResource ResourceTile}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><controls:ReflowPanel MinItemWidth="130" Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <Button x:Name="UnreadCharacterResourcesToggle" Classes="bare" HorizontalAlignment="Left" IsVisible="{Binding HasUnreadCharacterResources}"
                      Command="{Binding ToggleUnreadCharacterCommand}" Content="{Binding UnreadCharacterResourcesText}" />
              <controls:ExpandPanel IsExpanded="{Binding UnreadCharacterExpanded, Mode=OneWay}">
                <ItemsControl controls:StableItems.Source="{Binding UnreadCharacterResources}" ItemTemplate="{StaticResource UnreadResourceRow}" />
              </controls:ExpandPanel>
            </StackPanel>
          </controls:Card>
          <controls:Card x:Name="CoveragePanel" CardId="coverage" Title="{DynamicResource I.Coverage}" TitleTip="{DynamicResource I.CoverageHint}" Size="OneByAuto"
                         AllowedSizes="HalfByAuto,OneByOneAndHalf">
            <StackPanel Spacing="8">
              <ItemsControl controls:StableItems.Source="{Binding Data.Coverage}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="inventory:CoverageRow">
                    <controls:PairRow Margin="0,3">
                      <TextBlock Classes="muted" Text="{Binding Label}" />
                      <TextBlock Classes="body" FontWeight="Medium" Text="{Binding State}"
                                 Classes.confirmed="{Binding Complete}" Classes.unconfirmed="{Binding !Complete}" />
                    </controls:PairRow>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </controls:Card>
          <controls:Card x:Name="CatalogPanel" CardId="catalog" Title="{DynamicResource I.Catalog}" Size="OneByAuto"
                         AllowedSizes="HalfByAuto,OneByOne">
            <StackPanel Spacing="8">
              <ItemsControl controls:StableItems.Source="{Binding Data.Catalog}" />
            </StackPanel>
          </controls:Card>
      </controls:CardGrid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
