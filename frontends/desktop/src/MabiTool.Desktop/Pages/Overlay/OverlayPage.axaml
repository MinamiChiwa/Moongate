<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:page="using:MabiTool.Desktop.Pages.Overlay"
             xmlns:controls="using:MabiTool.Desktop.Controls"
             x:Class="MabiTool.Desktop.Pages.Overlay.OverlayPage"
             x:DataType="page:OverlayPageModel"
             controls:Card.PageId="overlay">
  <UserControl.Styles>
    <Style Selector="Button.segment.active">
      <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.chip.active">
      <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush}" />
    </Style>
  </UserControl.Styles>
  <Panel>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="8,4,8,14">
      <!-- 标题行：标题之后紧跟卡片布局的编辑入口（各页同一位置）；右端留给窗口右上角的按钮。 -->
      <DockPanel Margin="{DynamicResource TitleReserve}">
        <TextBlock DockPanel.Dock="Left" Classes="h1" Margin="0" Text="{DynamicResource O.Title}" />
        <controls:CardGridEditBar Target="{Binding #CardsGrid}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" />
      </DockPanel>
      <controls:ReflowPanel MinItemWidth="260" Spacing="12" Margin="0,4,0,0">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><TextBlock Classes="body muted" VerticalAlignment="Center" Text="{DynamicResource O.StatusShort}" /><controls:HelpTip Text="{DynamicResource O.Status}" /></StackPanel>
        <StackPanel HorizontalAlignment="Right">
          <WrapPanel HorizontalAlignment="Right">
            <controls:SelectionBorder Classes="segmented" Margin="0,0,8,6" VerticalAlignment="Center">
              <ItemsControl x:Name="LayoutTabs" controls:StableItems.Source="{Binding Layouts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="page:LayoutTab">
                    <Button Classes="segment" Classes.active="{Binding Selected}" Content="{Binding Name}"
                            Command="{Binding $parent[UserControl].((page:OverlayPageModel)DataContext).SelectLayoutCommand}"
                            CommandParameter="{Binding Id}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </controls:SelectionBorder>
            <Button x:Name="AddLayoutButton" Margin="0,0,8,6" Content="{DynamicResource O.AddLayout}" Command="{Binding AddLayoutCommand}" />
            <Button x:Name="RemoveLayoutButton" Margin="0,0,8,6" Content="{DynamicResource O.RemoveLayout}"
                    Command="{Binding RemoveLayoutCommand}" IsEnabled="{Binding CanRemoveLayout}" />
            <!-- 浮窗的显示状态：选中项取浮窗的实际状态，快捷键切换后同样更新。 -->
            <controls:SelectionBorder x:Name="OverlaySwitch" Classes="segmented" Margin="0,0,0,6" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ShowOverlayButton" Classes="segment" Classes.active="{Binding OverlayShown}"
                        Content="{DynamicResource O.ShowOverlay}" Command="{Binding ShowOverlayCommand}" />
                <Button x:Name="HideOverlayButton" Classes="segment" Classes.active="{Binding OverlayHidden}"
                        Content="{DynamicResource O.HideOverlay}" Command="{Binding HideOverlayCommand}" />
              </StackPanel>
            </controls:SelectionBorder>
          </WrapPanel>
        </StackPanel>
      </controls:ReflowPanel>
    </StackPanel>

    <ScrollViewer x:Name="PageScroller" controls:EdgeFade.IsEnabled="True" Margin="-14,0,-14,0"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <!-- 卡片网格：屏幕上摆放两列宽、选中元件设置一列宽，同一行等高；元件库全宽。都随内容。元件的位置与尺寸在实际屏幕上编辑，页面里没有预览画布。 -->
      <controls:CardGrid x:Name="CardsGrid" Margin="14,0,14,18">
          <controls:Card x:Name="ScreenPanel" CardId="screen" Title="{DynamicResource O.ScreenTitle}" Size="TwoByAuto" AllowedSizes="FullWidth">
            <StackPanel Spacing="10">
              <TextBlock x:Name="EditStatus" Classes="note" TextWrapping="Wrap" Text="{Binding StatusLine}" />
              <WrapPanel>
                <!-- 进入编辑后各元件在实际屏幕上可拖动、改尺寸；再按一次（或浮窗上的“完成编辑”）退出并保存。 -->
                <Button x:Name="EditButton" Classes="chip" Classes.active="{Binding IsEditing}" Margin="0,0,6,6"
                        Content="{Binding EditAction}" Command="{Binding EditCommand}" ToolTip.Tip="{DynamicResource O.EditHint}" />
                <Button x:Name="MoveAllToPrimaryButton" Classes="chip" Margin="0,0,0,6" Content="{DynamicResource O.MoveAllToPrimary}"
                        Command="{Binding MoveAllToPrimaryCommand}" ToolTip.Tip="{DynamicResource O.MoveAllToPrimaryHint}" />
              </WrapPanel>
              <controls:PairRow>
                <TextBlock Classes="muted" Text="{DynamicResource O.Monitors}" />
                <TextBlock x:Name="MonitorsText" Classes="body" TextWrapping="Wrap" TextAlignment="Right" Text="{Binding MonitorsText}" />
              </controls:PairRow>
              <!-- 不用拖动也能换屏（远程桌面一次只显示一块屏幕时拖不过去）：当前版面的元件全部移到所选显示器，比例位置不变。 -->
              <controls:PairRow IsVisible="{Binding HasMonitorChoice}">
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding MoveAllLabel}" />
                <controls:SelectionBorder x:Name="MoveAllMonitors" Classes="segmented" HorizontalAlignment="Right">
                  <ItemsControl controls:StableItems.Source="{Binding AllMonitorChoices}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="page:MonitorOption">
                        <Button Classes="segment" Classes.active="{Binding Selected}" Content="{Binding Label}" ToolTip.Tip="{Binding Tip}"
                                AutomationProperties.Name="{Binding Tip}"
                                Command="{Binding $parent[UserControl].((page:OverlayPageModel)DataContext).MoveAllToMonitorCommand}"
                                CommandParameter="{Binding Key}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </controls:SelectionBorder>
              </controls:PairRow>
              <WrapPanel>
                <!-- 选中表示当前版面的元件都已上锁；有元件解锁时按下全部上锁，否则全部解锁。 -->
                <Button x:Name="LockAllButton" Classes="chip" Classes.active="{Binding AllLocked}" Margin="0,0,6,6"
                        Content="{DynamicResource O.LockAll}" Command="{Binding ToggleAllLocksCommand}"
                        ToolTip.Tip="{DynamicResource O.LockAllHint}" />
                <!-- 录屏时隐藏用 WDA_EXCLUDEFROMCAPTURE，Windows 10 2004 之前没有：停用并在提示里写明。 -->
                <Button Classes="chip" Classes.active="{Binding HideFromCapture}" Margin="0,0,6,6"
                        Content="{DynamicResource O.HideFromCapture}" Command="{Binding ToggleCaptureCommand}"
                        IsEnabled="{Binding CaptureSupported}" ToolTip.ShowOnDisabled="True"
                        ToolTip.Tip="{Binding CaptureHint}" />
                <!-- 缺省关闭：浮窗是屏幕级的独立窗口，始终显示；开启后游戏窗口最小化期间整个浮窗不显示。 -->
                <Button x:Name="HideWithGameButton" Classes="chip" Classes.active="{Binding HideWithGame}" Margin="0,0,0,6"
                        Content="{DynamicResource O.HideWithGame}" Command="{Binding ToggleHideWithGameCommand}"
                        ToolTip.Tip="{DynamicResource O.HideWithGameHint}" />
              </WrapPanel>
            </StackPanel>
          </controls:Card>

        <controls:Card x:Name="AppearancePanel" CardId="appearance" Title="{Binding SelectedTitle}" TitleTip="{DynamicResource O.SettingsHint}" Size="OneByAuto"
                       AllowedSizes="HalfByAuto,FullWidth,OneByThree,OneByFour">
          <StackPanel Spacing="12">
            <TextBlock Classes="note" Text="{DynamicResource O.NoSelection}" IsVisible="{Binding NoSelection}" />
            <StackPanel Spacing="12" IsVisible="{Binding HasSelection}">
              <ItemsControl controls:StableItems.Source="{Binding SelectedDetails}" />
              <!-- 含属性图标的元件：图标与名称的对照。浮窗上锁时鼠标穿透、看不到提示，解锁或编辑位置时悬停图标可看名称。 -->
              <StackPanel x:Name="IconLegend" Spacing="6" IsVisible="{Binding HasSelectedIcons}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Classes="muted" Text="{DynamicResource O.IconLegend}" />
                  <controls:HelpTip Text="{DynamicResource O.IconLegendHint}" />
                </StackPanel>
                <ItemsControl controls:StableItems.Source="{Binding SelectedIcons}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="page:IconLegendItem">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                        <controls:ClientIconSlot Icon="{Binding Icon}" Label="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <!-- DPS 元件的怪物血量区块：显示或隐藏，立即保存；问号说明写用途。 -->
              <controls:PairRow IsVisible="{Binding HasHealthSetting}">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding HealthLabel}" />
                  <controls:HelpTip Text="{Binding HealthHint}" />
                </StackPanel>
                <controls:SelectionBorder x:Name="HealthSwitch" Classes="segmented" HorizontalAlignment="Right">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="HealthShowButton" Classes="segment" Classes.active="{Binding HealthShown}" Content="{Binding ShowLabel}"
                            Command="{Binding HealthCommand}" CommandParameter="show" />
                    <Button x:Name="HealthHideButton" Classes="segment" Classes.active="{Binding HealthHidden}" Content="{Binding HideLabel}"
                            Command="{Binding HealthCommand}" CommandParameter="hide" />
                  </StackPanel>
                </controls:SelectionBorder>
              </controls:PairRow>
              <!-- 所选元件移到另一块显示器：比例位置不变，立即保存；只有一块显示器时不显示。 -->
              <controls:PairRow IsVisible="{Binding HasMonitorChoice}">
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding MoveToLabel}" />
                <controls:SelectionBorder x:Name="WidgetMonitors" Classes="segmented" HorizontalAlignment="Right">
                  <ItemsControl controls:StableItems.Source="{Binding MonitorChoices}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="page:MonitorOption">
                        <Button Classes="segment" Classes.active="{Binding Selected}" Content="{Binding Label}" ToolTip.Tip="{Binding Tip}"
                                AutomationProperties.Name="{Binding Tip}"
                                Command="{Binding $parent[UserControl].((page:OverlayPageModel)DataContext).MoveToMonitorCommand}"
                                CommandParameter="{Binding Key}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </controls:SelectionBorder>
              </controls:PairRow>
              <controls:PairRow>
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{DynamicResource O.Lock}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock x:Name="LockStateText" VerticalAlignment="Center" Text="{Binding LockState}" />
                  <Button x:Name="LockToggleButton" Classes="chip" Content="{Binding LockAction}" Command="{Binding ToggleLockCommand}" />
                </StackPanel>
              </controls:PairRow>
              <controls:PairRow>
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{DynamicResource O.Scale}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button x:Name="ScaleDown" Classes="chip" Width="34" Padding="0" Content="−" Command="{Binding ScaleCommand}" CommandParameter="-" />
                  <TextBlock VerticalAlignment="Center" MinWidth="44" TextAlignment="Center" Text="{Binding ScaleText}" />
                  <Button x:Name="ScaleUp" Classes="chip" Width="34" Padding="0" Content="+" Command="{Binding ScaleCommand}" CommandParameter="+" />
                </StackPanel>
              </controls:PairRow>
              <controls:PairRow>
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{DynamicResource O.BackgroundOpacity}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button x:Name="BackgroundOpacityDown" Classes="chip" Width="34" Padding="0" Content="−" Command="{Binding BackgroundOpacityCommand}" CommandParameter="-" />
                  <TextBlock VerticalAlignment="Center" MinWidth="44" TextAlignment="Center" Text="{Binding BackgroundOpacityText}" />
                  <Button x:Name="BackgroundOpacityUp" Classes="chip" Width="34" Padding="0" Content="+" Command="{Binding BackgroundOpacityCommand}" CommandParameter="+" />
                </StackPanel>
              </controls:PairRow>
              <controls:PairRow>
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{DynamicResource O.ContentOpacity}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button x:Name="ContentOpacityDown" Classes="chip" Width="34" Padding="0" Content="−" Command="{Binding ContentOpacityCommand}" CommandParameter="-" />
                  <TextBlock VerticalAlignment="Center" MinWidth="44" TextAlignment="Center" Text="{Binding ContentOpacityText}" />
                  <Button x:Name="ContentOpacityUp" Classes="chip" Width="34" Padding="0" Content="+" Command="{Binding ContentOpacityCommand}" CommandParameter="+" />
                </StackPanel>
              </controls:PairRow>
              <TextBlock Classes="muted" Text="{DynamicResource O.Skin}" />
              <controls:SelectionBorder Classes="segmented" HorizontalAlignment="Left">
                <ItemsControl controls:StableItems.Source="{Binding Skins}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="page:SkinOption">
                      <Button Classes="segment" Classes.active="{Binding Selected}" Content="{Binding Label}"
                              Command="{Binding $parent[UserControl].((page:OverlayPageModel)DataContext).SkinCommand}"
                              CommandParameter="{Binding Id}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </controls:SelectionBorder>
              <Border Classes="inset" IsVisible="{Binding UsesImage}">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="strong" Text="{DynamicResource O.FrameImage}" /><controls:HelpTip Text="{DynamicResource O.FrameImageHint}" /></StackPanel>
                  <TextBox x:Name="ImagePathBox" Classes="field" Text="{Binding ImagePath}"
                           PlaceholderText="{DynamicResource O.FrameImagePath}" />
                  <Button Classes="chip" HorizontalAlignment="Left" Content="{DynamicResource O.PickImage}" Click="OnPickImage" />
                </StackPanel>
              </Border>
              <WrapPanel>
                <Button x:Name="ResetPositionButton" Margin="0,0,8,6" Content="{DynamicResource O.ResetPosition}"
                        Command="{Binding ResetPositionCommand}" />
                <Button x:Name="RemoveWidgetButton" Margin="0,0,0,6" Content="{DynamicResource O.RemoveWidget}"
                        Command="{Binding RemoveWidgetCommand}" />
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </controls:Card>

          <controls:Card x:Name="LibraryPanel" CardId="library" Title="{DynamicResource O.Library}" TitleTip="{DynamicResource O.LibraryHint}" Padding="16" AllowedSizes="TwoByAuto,HalfByAuto">
            <controls:Card.Actions>
              <Button x:Name="GameDataButton" Content="{DynamicResource O.GameDataEntry}" Command="{Binding OpenGameDataCommand}"
                      ToolTip.Tip="{DynamicResource O.GameDataEntryHint}" />
            </controls:Card.Actions>
            <StackPanel Spacing="10">
              <ItemsControl controls:StableItems.Source="{Binding Library}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><controls:ReflowPanel MinItemWidth="190" Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="page:LibraryItem">
                    <Button Classes="tile" Classes.active="{Binding Placed}" Padding="10,8" HorizontalAlignment="Stretch"
                            Command="{Binding $parent[UserControl].((page:OverlayPageModel)DataContext).ToggleWidgetCommand}"
                            CommandParameter="{Binding WidgetId}">
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"
                                VerticalAlignment="Center" Background="{Binding Accent}" />
                        <StackPanel>
                          <TextBlock Classes="name" FontSize="13" Text="{Binding Title}" />
                          <TextBlock Classes="name muted" FontSize="12" Text="{Binding Group}" />
                          <TextBlock Classes="note unconfirmed" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" />
                        </StackPanel>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </controls:Card>
      </controls:CardGrid>
    </ScrollViewer>
  </DockPanel>

  <!-- 需要游戏数据的元件：依赖游戏内数据的元件集中在这一层；点外面或按 Esc 关闭，Tab 只在层内循环。 -->
  <Panel x:Name="GameDataLayer" IsVisible="{Binding IsGameDataOpen}" KeyDown="OnGameDataKeyDown">
    <Border Background="Transparent" PointerPressed="OnGameDataOutsidePressed" />
    <Border x:Name="GameDataPanel" Classes="panel popup" Classes.open="{Binding IsGameDataOpen}" MaxWidth="460"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14,56,14,14" KeyboardNavigation.TabNavigation="Cycle">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" x:Name="GameDataClose" Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center"
                  Content="{DynamicResource S.ClosePicker}" Command="{Binding CloseGameDataCommand}"
                  AutomationProperties.Name="{DynamicResource S.ClosePicker}" />
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="h2" FontSize="17" Text="{DynamicResource O.GameDataTitle}" /><controls:HelpTip Text="{DynamicResource O.GameDataHint}" /></StackPanel>
        </DockPanel>
        <ScrollViewer controls:EdgeFade.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="GameDataList" controls:StableItems.Source="{Binding GameDataLibrary}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="page:LibraryItem">
                <Button Classes="tile" Classes.active="{Binding Placed}" Padding="10,8" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                        Command="{Binding $parent[UserControl].((page:OverlayPageModel)DataContext).ToggleWidgetCommand}"
                        CommandParameter="{Binding WidgetId}">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"
                            VerticalAlignment="Center" Background="{Binding Accent}" />
                    <StackPanel>
                      <TextBlock Classes="name" FontSize="13" Text="{Binding Title}" />
                      <TextBlock Classes="name muted" FontSize="12" Text="{Binding Group}" />
                      <TextBlock Classes="note unconfirmed" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" />
                    </StackPanel>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Panel>
  </Panel>
</UserControl>
