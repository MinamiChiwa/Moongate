<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:MabiTool.Desktop.Shell"
        xmlns:music="using:MabiTool.Desktop.Pages.Music"
        xmlns:controls="using:MabiTool.Desktop.Controls"
        x:Class="MabiTool.Desktop.Shell.MiniWindow"
        x:DataType="shell:MiniWindowModel"
        Title="Moongate Mini"
        Width="440" Height="920" MinWidth="340" MinHeight="640"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <!-- 演奏中的磁贴用乐谱库的模块色调描边；所选磁贴用选中底色。 -->
    <Style Selector="Button.tile.playing">
      <Setter Property="BorderBrush" Value="#C97A10" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.tile.miniscore">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
  </Window.Styles>

  <Panel>
    <Border x:Name="Frame" CornerRadius="26" ClipToBounds="True" Background="{DynamicResource CanvasBrush}">
      <Panel>
        <Border Background="{DynamicResource AmberHaloBrush}" />
        <Border Background="{DynamicResource BlueHaloBrush}" />
        <Image Source="{Binding BackdropImage}" Stretch="UniformToFill" IsVisible="{Binding HasBackdrop}" IsHitTestVisible="False" />
        <Border Background="{Binding BackdropScrim}" IsVisible="{Binding HasBackdrop}" IsHitTestVisible="False" />

        <DockPanel Margin="12">
          <!-- 顶部：当前清单、绑定状态、回到主窗口与关闭；这块面板（含上方窗口边距）内的空白处拖动窗口。 -->
          <Border DockPanel.Dock="Top" x:Name="TopPanel" Classes="panel" Padding="16,12" Margin="0,0,0,10">
            <StackPanel Spacing="10">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="8,0,0,0">
                  <Button x:Name="ShowMainButton" Classes="chip" Content="{DynamicResource MW.ShowMain}"
                          Command="{Binding ShowMainCommand}" ToolTip.Tip="{DynamicResource MW.ShowMainHint}" />
                  <Button x:Name="CloseButton" Classes="window close" Click="OnCloseClick" ToolTip.Tip="{DynamicResource MW.Close}"
                          AutomationProperties.Name="{DynamicResource MW.Close}">
                    <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" />
                  </Button>
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="name" FontSize="22" FontWeight="Black" Text="{Binding ListName}" />
                  <TextBlock Classes="name" FontSize="12" FontWeight="Medium" Text="{Binding BindingLine}"
                             Classes.confirmed="{Binding Binding.Confirmed}" Classes.unconfirmed="{Binding !Binding.Confirmed}" />
                </StackPanel>
              </DockPanel>
              <controls:SelectionBorder>
                <ItemsControl x:Name="PlaylistChips" controls:StableItems.Source="{Binding Data.Playlists}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="music:PlaylistChip">
                      <Button Classes="chip" Classes.active="{Binding Selected}" Margin="0,0,6,6" MaxWidth="180"
                              Command="{Binding $parent[Window].((shell:MiniWindowModel)DataContext).IntentCommand}"
                              CommandParameter="{Binding Intent}">
                        <!-- 封面完整显示，清单名占标签内的剩余宽度并省略，全文在悬停提示里。 -->
                        <DockPanel>
                          <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="5" Margin="0,0,6,0" Background="{Binding Cover}" VerticalAlignment="Center"
                                  BorderBrush="{DynamicResource ControlEdgeBrush}" BorderThickness="1">
                            <controls:PackImage Kind="Playlist" Key="{Binding Id}" Radius="5" />
                          </Border>
                          <TextBlock Classes="name" VerticalAlignment="Center" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                        </DockPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </controls:SelectionBorder>
            </StackPanel>
          </Border>

          <!-- 底部活动区：当前曲目、受理／送出／生效、下一首、停止与紧急停止；游戏内演奏不可用的说明在按钮下方。 -->
          <Border DockPanel.Dock="Bottom" x:Name="ActivityPanel" Classes="panel" Padding="16,12" Margin="0,10,0,0">
            <StackPanel Spacing="8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Classes="note" FontWeight="Bold" Margin="0,0,10,0" Text="{DynamicResource MW.NowPlaying}" />
                <TextBlock Classes="name muted" FontSize="12" TextAlignment="Right" Text="{Binding QueueSummary}"
                           ToolTip.Tip="{Binding QueueSummary}" />
              </DockPanel>
              <TextBlock x:Name="CurrentTitle" Classes="name strong" FontSize="17" Text="{Binding CurrentTitle}" />
              <ItemsControl ItemsSource="{Binding Stages}" IsVisible="{Binding ShowStages}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="shell:StageViewModel">
                    <Border Classes="inset" Padding="10,4" CornerRadius="15" Margin="0,0,6,6">
                      <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding Text}"
                                 Classes.confirmed="{Binding IsDone}" Classes.unconfirmed="{Binding IsUnknown}"
                                 Classes.muted="{Binding IsPending}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="note" Text="{Binding ActivityLine}" IsVisible="{Binding !ShowStages}" />
              <TextBlock Classes="name muted" FontSize="13" Text="{Binding NextLine}" />
              <WrapPanel>
                <Button x:Name="NextButton" Margin="0,0,8,6" Content="{DynamicResource M.Next}"
                        Command="{Binding IntentCommand}" CommandParameter="music.next" IsEnabled="{Binding CanNext}" />
                <Button x:Name="StopButton" Margin="0,0,8,6" Content="{DynamicResource M.Stop}"
                        Command="{Binding IntentCommand}" CommandParameter="music.stop" IsEnabled="{Binding CanStop}" />
                <Button x:Name="EmergencyStopButton" Classes="stop" Margin="0,0,0,6" Content="{DynamicResource S.EmergencyStop}"
                        Command="{Binding EmergencyStopCommand}" IsEnabled="{Binding Activity.CanEmergencyStop}" />
              </WrapPanel>
              <TextBlock x:Name="CapabilityNotice" Classes="note" Text="{Binding CapabilityNotice}" IsVisible="{Binding HasCapabilityNotice}" />
            </StackPanel>
          </Border>

          <!-- 所选乐谱的操作：沿用乐谱库页的加入队列与开始演奏。 -->
          <Border DockPanel.Dock="Bottom" x:Name="SelectionBar" Classes="panel" Padding="16,10" Margin="0,10,0,0"
                  IsVisible="{Binding HasSelection}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button x:Name="EnqueueButton" Classes="primary" Content="{DynamicResource M.Enqueue}"
                        Command="{Binding IntentCommand}" CommandParameter="{Binding EnqueueIntent}" IsEnabled="{Binding CanEnqueue}" />
                <Button x:Name="StartButton" Content="{DynamicResource M.Start}"
                        Command="{Binding IntentCommand}" CommandParameter="music.start" IsEnabled="{Binding CanStart}" />
              </StackPanel>
              <TextBlock Classes="name strong" VerticalAlignment="Center" Text="{Binding SelectedLine}" ToolTip.Tip="{Binding SelectedLine}" />
            </DockPanel>
          </Border>

          <!-- 中部：乐谱磁贴。同名乐谱逐张列出，游戏无法选取的显示原因且不能选。 -->
          <DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="4,8,4,0" IsVisible="{Binding HasPages}">
              <Button x:Name="PreviousPageButton" DockPanel.Dock="Left" Classes="chip" Content="{DynamicResource M.PreviousPage}"
                      Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}" />
              <Button x:Name="NextPageButton" DockPanel.Dock="Right" Classes="chip" Content="{DynamicResource M.NextPage}"
                      Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}" />
              <TextBlock Classes="note" Margin="8,0" TextAlignment="Center" VerticalAlignment="Center" Text="{Binding PageLabel}" />
            </DockPanel>
            <!-- 滚动区向左右与上方伸出、内容再缩回同样多：位置不变，首尾磁贴悬停放大后不被视口切掉。 -->
            <ScrollViewer x:Name="TileScroller" controls:EdgeFade.IsEnabled="True" Margin="-12,-8,-12,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="12,8,12,4">
                <Border Classes="panel" Padding="16" IsVisible="{Binding NoScores}">
                  <TextBlock Classes="note" Text="{DynamicResource M.NoScores}" />
                </Border>
                <ItemsControl x:Name="TileList" controls:StableItems.Source="{Binding Tiles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><controls:ReflowPanel MinItemWidth="150" Spacing="8" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="shell:MiniScoreTile">
                      <Button Classes="tile miniscore" Classes.active="{Binding Selected}" Classes.playing="{Binding Playing}"
                              IsEnabled="{Binding Selectable}"
                              Command="{Binding $parent[Window].((shell:MiniWindowModel)DataContext).SelectCommand}"
                              CommandParameter="{Binding Id}">
                        <StackPanel Spacing="3">
                          <TextBlock Classes="name strong" FontSize="15" Text="{Binding Title}" ToolTip.Tip="{Binding Title}" />
                          <DockPanel>
                            <controls:PackImage DockPanel.Dock="Left" Width="16" Height="16" Radius="4" Margin="0,0,5,0"
                                                Kind="Instrument" Key="{Binding InstrumentId}" CollapseWhenEmpty="True" />
                            <TextBlock Classes="name muted" FontSize="12" VerticalAlignment="Center" Text="{Binding Meta}" />
                          </DockPanel>
                          <TextBlock Classes="note" Text="{Binding Tag}" IsVisible="{Binding HasTag}"
                                     Classes.unconfirmed="{Binding !Selectable}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </DockPanel>
      </Panel>
    </Border>

    <!-- 无边框窗口的缩放感应区。 -->
    <Border Tag="North" Height="6" VerticalAlignment="Top" Margin="12,0" Background="Transparent" Cursor="SizeNorthSouth" PointerPressed="OnResizePressed" />
    <Border Tag="South" Height="6" VerticalAlignment="Bottom" Margin="12,0" Background="Transparent" Cursor="SizeNorthSouth" PointerPressed="OnResizePressed" />
    <Border Tag="West" Width="6" HorizontalAlignment="Left" Margin="0,12" Background="Transparent" Cursor="SizeWestEast" PointerPressed="OnResizePressed" />
    <Border Tag="East" Width="6" HorizontalAlignment="Right" Margin="0,12" Background="Transparent" Cursor="SizeWestEast" PointerPressed="OnResizePressed" />
    <Border Tag="NorthWest" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" PointerPressed="OnResizePressed" />
    <Border Tag="NorthEast" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" PointerPressed="OnResizePressed" />
    <Border Tag="SouthWest" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="OnResizePressed" />
    <Border Tag="SouthEast" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" PointerPressed="OnResizePressed" />
  </Panel>
</Window>
