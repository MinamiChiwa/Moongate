<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:MabiTool.Desktop.Infrastructure"
             xmlns:controls="using:MabiTool.Desktop.Controls"
             x:Class="MabiTool.Desktop.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.DataTemplates>
    <!-- 标签与数值的一行：放不下时数值换到标签下方。 -->
    <DataTemplate DataType="infra:KeyValue">
      <controls:PairRow Margin="0,3">
        <TextBlock Classes="muted" Text="{Binding Label}" />
        <TextBlock Classes="body" Text="{Binding Value}" />
      </controls:PairRow>
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Theme/Controls.axaml" />
    <!-- 窗口图标由各窗口构造时设置（Shell/AppIcon），不经过样式。 -->
  </Application.Styles>
</Application>
