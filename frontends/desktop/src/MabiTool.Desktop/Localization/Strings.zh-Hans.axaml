  <sys:String x:Key="I.ColCategory">类别</sys:String>
  <sys:String x:Key="I.ColNameSource">名称来源</sys:String>
  <sys:String x:Key="I.ColTotal">合计</sys:String>
  <sys:String x:Key="I.Backpack">背包</sys:String>
  <sys:String x:Key="I.CharacterStorage">角色保管箱</sys:String>
  <sys:String x:Key="I.AccountStorage">公共保管箱</sys:String>
  <sys:String x:Key="I.ColNote">备注</sys:String>
  <sys:String x:Key="I.Account">账号</sys:String>
  <sys:String x:Key="I.NoAccount">尚未读取到账号</sys:String>
  <sys:String x:Key="I.OpenWindow">在窗口中打开</sys:String>
  <sys:String x:Key="I.ExportCsv">导出 CSV</sys:String>
  <sys:String x:Key="I.Groups">显示</sys:String>
  <sys:String x:Key="I.TableHint">“未读取”表示该角色的这一处尚未完整读取；0 表示已完整读取且没有这件道具。合计为已读取数量之和，有未读取的格子时显示为灰色。</sys:String>
  <sys:String x:Key="I.WindowTitle">背包表格</sys:String>
  <sys:String x:Key="I.CloseWindow">关闭窗口</sys:String>
  <sys:String x:Key="I.NoItems">没有符合的道具</sys:String>
  <sys:String x:Key="I.Summary">概况</sys:String>
  <sys:String x:Key="I.SummaryCharacter">角色</sys:String>
  <sys:String x:Key="I.Resources">资源</sys:String>
  <sys:String x:Key="I.ResourcesHint">按客户端的划分：账户资源（M 币、德卡、商城点数、套组点数、公会币、韦卡）同账户各角色共用，跟随上方账号选择；其余为角色资源，每个角色一份。换频道或进图时随登录数据读取全部数值，之后随变化更新；金币、银币、魔族贡品在“概况”。悬停查看最近变化与说明。</sys:String>
  <sys:String x:Key="I.AccountResources">账户资源</sys:String>
  <sys:String x:Key="I.CharacterResources">角色资源</sys:String>
  <sys:String x:Key="I.Coverage">读取范围</sys:String>
  <sys:String x:Key="I.CoverageHint">标为不完整的范围可能缺少道具。</sys:String>
  <sys:String x:Key="I.Catalog">道具名称目录</sys:String>
  <sys:String x:Key="X.Title">模块与扩展</sys:String>
  <sys:String x:Key="X.Status">导航、页面、浮窗元件和设置都由模块声明，安装后自动出现</sys:String>
  <sys:String x:Key="X.ImportAssets">导入素材包</sys:String>
  <sys:String x:Key="X.Install">安装扩展模块</sys:String>
  <sys:String x:Key="X.InstallUnavailable">后端尚未提供扩展模块安装，暂不可用</sys:String>
  <sys:String x:Key="X.Installed">已安装</sys:String>
  <sys:String x:Key="X.Disconnected">未连接后端，模块状态未知</sys:String>
  <sys:String x:Key="X.Points">扩展模块能接上的位置</sys:String>
  <sys:String x:Key="X.Assets">可替换的图像</sys:String>
  <sys:String x:Key="X.AssetsHint">图像存成素材，以固定编号引用。换图不影响数据，移除素材包会回到内建外观。</sys:String>
  <sys:String x:Key="T.Title">设置</sys:String>
  <sys:String x:Key="T.Status">语言、快捷键、更新与后端连接</sys:String>
  <sys:String x:Key="T.Interface">界面</sys:String>
  <sys:String x:Key="T.LanguageHint">游戏里的名称（角色、技能、怪物、道具、乐谱）按原文显示，不随界面语言转换。</sys:String>
  <sys:String x:Key="T.Shortcuts">全局快捷键</sys:String>
  <sys:String x:Key="T.NoShortcuts">后端没有报告快捷键</sys:String>
  <sys:String x:Key="T.Update">更新</sys:String>
  <sys:String x:Key="T.UpdateHint">只自动检查并在这里提示；下载和安装由你决定。安装时 Moongate 会关闭并自动打开新版本，失败时自动回到当前版本；userdata 里的数据不受影响。</sys:String>
  <sys:String x:Key="T.CheckUpdate">检查更新</sys:String>
  <sys:String x:Key="G.CaptureSettings">前往设置</sys:String>
  <sys:String x:Key="T.Capture">抓包</sys:String>
  <sys:String x:Key="T.CaptureAuto">自动抓包</sys:String>
  <sys:String x:Key="T.CaptureAutoHint">绑定游戏窗口并确定网卡后自动开始抓包并保持运行；合奏、DPS检测、背包等功能共用这一次抓包。关闭后停止抓包，不再自动开始。</sys:String>
  <sys:String x:Key="T.CaptureChannel">网卡</sys:String>
  <sys:String x:Key="T.ChannelAuto">自动选择</sys:String>
  <sys:String x:Key="T.ChannelManual">指定网卡</sys:String>
  <sys:String x:Key="T.ChannelHint">自动选择按游戏连接的本机地址确定网卡。使用加速器、VPN 或虚拟网卡时，可从列表指定网卡，或用手动调试找出网卡。</sys:String>
  <sys:String x:Key="T.ListChannels">列出网卡</sys:String>
