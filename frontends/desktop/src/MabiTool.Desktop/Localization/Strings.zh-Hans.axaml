<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
  <!-- 简体中文界面文字（默认）。游戏来源的名称不在此表，按原文显示。 -->
  <FontFamily x:Key="UiFont">fonts:Moongate#Noto Sans SC, Noto Sans TC</FontFamily>
  <sys:String x:Key="S.ProductName">Moongate</sys:String>
  <sys:String x:Key="S.Language">语言</sys:String>
  <sys:String x:Key="S.Close">关闭窗口</sys:String>
  <sys:String x:Key="S.Minimize">最小化</sys:String>
  <sys:String x:Key="S.Maximize">最大化</sys:String>
  <sys:String x:Key="S.Restore">还原</sys:String>
