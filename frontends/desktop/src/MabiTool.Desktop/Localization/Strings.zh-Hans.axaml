  <sys:String x:Key="S.Capture">抓包</sys:String>
  <sys:String x:Key="S.NpcapTitle">抓包需要 Npcap</sys:String>
  <sys:String x:Key="S.NpcapBody">抓包依赖 Npcap 网络抓包驱动。Npcap 不随 Moongate 发行，需要你从官方网站下载并自行安装。</sys:String>
  <sys:String x:Key="S.NpcapUrlLabel">官方下载页</sys:String>
  <sys:String x:Key="S.NpcapRetry">安装完成后不需要重新开始：工具每隔 5–60 秒自动重试，约一分钟内开始抓包；也可在设置里把自动抓包关闭再打开，立即重试。</sys:String>
  <sys:String x:Key="S.NpcapOpen">打开下载页</sys:String>
  <sys:String x:Key="S.NpcapCopy">复制地址</sys:String>
  <sys:String x:Key="S.NpcapLater">稍后</sys:String>
  <sys:String x:Key="S.NpcapGuide">查看指引</sys:String>
