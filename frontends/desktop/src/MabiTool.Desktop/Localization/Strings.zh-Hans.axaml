  <sys:String x:Key="C.EffectsNone">无</sys:String>
  <sys:String x:Key="C.AllEffects">这一行的全部效果</sys:String>
  <sys:String x:Key="C.AllTargets">全部目标</sys:String>
  <sys:String x:Key="C.SaveRecord">保存记录</sys:String>
  <sys:String x:Key="C.SaveRecordNote">把当前范围的数据存入战斗历史，记录自动收藏、不会被清理</sys:String>
  <sys:String x:Key="C.RecordName">记录名称（1–60 字）</sys:String>
  <sys:String x:Key="C.Save">保存</sys:String>
  <sys:String x:Key="C.ResetConfirmTitle">重设当前统计？</sys:String>
  <sys:String x:Key="C.ResetConfirmNote">当前分段结束并存入战斗历史，统计从现在重新开始；“整场”也从这里重新累计。</sys:String>
  <sys:String x:Key="C.Scope">统计范围</sys:String>
  <sys:String x:Key="C.ScopeWhole">整场</sys:String>
  <sys:String x:Key="C.ScopeWholeTip">本次观测自最近一次重设起的全部分段，DPS 分母为各分段时长之和</sys:String>
