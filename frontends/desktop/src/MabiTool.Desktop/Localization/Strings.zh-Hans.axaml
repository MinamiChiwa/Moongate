  <sys:String x:Key="C.Traits">攻击特性</sys:String>
  <sys:String x:Key="C.TraitsNote">暴击以可暴击次数为分母，强击、连击、追击以直接伤害次数为分母，其余以全部已归属伤害次数为分母</sys:String>
  <sys:String x:Key="C.Elements">元素构成</sys:String>
  <sys:String x:Key="C.ElementsNote">占全部已归属伤害次数的比例，一次伤害可带多个元素</sys:String>
  <sys:String x:Key="C.NoElements">无元素</sys:String>
  <sys:String x:Key="C.Healing">治疗</sys:String>
  <sys:String x:Key="C.HealingNote">本机施放与受到的治疗；协议不提供受疗来源与技能</sys:String>
  <sys:String x:Key="C.NoHealing">未提供治疗数据</sys:String>
  <sys:String x:Key="C.HealingTargets">治疗目标</sys:String>
  <sys:String x:Key="C.ColHealing">治疗量</sys:String>
  <sys:String x:Key="C.SelfEffects">自身效果</sys:String>
  <sys:String x:Key="C.SelfGlyph">身</sys:String>
  <sys:String x:Key="C.SelfNote">覆盖率以本场已观测时间为分母</sys:String>
  <sys:String x:Key="C.TargetEffects">怪物效果</sys:String>
  <sys:String x:Key="C.TargetGlyph">敌</sys:String>
  <sys:String x:Key="C.History">战斗记录</sys:String>
  <sys:String x:Key="C.HistoryGlyph">录</sys:String>
  <sys:String x:Key="C.OnlyFavorites">只看已收藏</sys:String>
  <sys:String x:Key="C.CleanOld">清理旧记录</sys:String>
  <sys:String x:Key="C.AutoTip">开启时后端在抓包运行时自动保持 DPS 观测，不需要手动开始；关闭后改为手动开始与停止</sys:String>
  <sys:String x:Key="C.Cancel">取消</sys:String>
  <sys:String x:Key="C.Close">关闭</sys:String>
  <sys:String x:Key="C.TimerSettings">定时测量设定</sys:String>
  <sys:String x:Key="C.TimerSettingsNote">时长 5 秒至 60 分钟；开始后等待你的第一次有效伤害，从那一击起按时长计时</sys:String>
  <sys:String x:Key="C.Minutes">分</sys:String>
  <sys:String x:Key="C.Seconds">秒</sys:String>
  <sys:String x:Key="C.Apply">确定</sys:String>
  <sys:String x:Key="C.StartTimer">开始计时</sys:String>
  <sys:String x:Key="C.WaitFirstHit">等待首次伤害</sys:String>
  <sys:String x:Key="C.EffectFavoritesOnly">只显示收藏</sys:String>
  <sys:String x:Key="C.EffectFavoritesOnlyTip">只显示已收藏的效果；主页面与浮窗同时生效</sys:String>
  <sys:String x:Key="C.ManageFavorites">收藏…</sys:String>
  <sys:String x:Key="C.ManageFavoritesTip">按名称或编号搜索已提取到的效果并收藏</sys:String>
  <sys:String x:Key="C.FavoritesTitle">效果收藏</sys:String>
  <sys:String x:Key="C.FavoritesSearch">按名称或编号搜索</sys:String>
